#!/bin/bash
# Stand-in for libvips's vipsthumbnail, which the pneuma image does not ship
# and without which omarchy-menu-images drops every image from its listing.
# Covers the one call it makes, rendered with ImageMagick instead:
#   vipsthumbnail IMAGE --size WxH --smartcrop=centre --path OUT[Q=82,strip]
set -euo pipefail

image="" size="1536x864" out=""
while (($# > 0)); do
  case $1 in
    --size) size=$2; shift 2 ;;
    --size=*) size=${1#*=}; shift ;;
    --path) out=$2; shift 2 ;;
    --path=*) out=${1#*=}; shift ;;
    --*) shift ;;
    *) image=$1; shift ;;
  esac
done
[[ -n $image && -n $out ]] || { echo "usage: vipsthumbnail IMAGE --size WxH --path OUT" >&2; exit 1; }

target=${out%%\[*}
quality=82
[[ $out == *Q=* ]] && { quality=${out##*Q=}; quality=${quality%%[,\]]*}; }

MAGICK_THREAD_LIMIT=1 magick "$image" -auto-orient \
  -resize "${size}^" -gravity center -extent "$size" \
  -strip -quality "$quality" "$target"
