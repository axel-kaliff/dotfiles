[Unit]
Description=screentime enforcement daemon (per-app budgets and blocked windows)
PartOf=graphical-session.target
After=awatcher.service
Wants=awatcher.service

[Service]
Environment=PYTHONPATH=%h/projects/screentime/src
ExecStart=/usr/bin/python3 -m screentime run
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2

[Install]
WantedBy=graphical-session.target
