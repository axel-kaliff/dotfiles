[Unit]
Description=Clipboard history capture (pneuma-clipboard-watch)
PartOf=cosmic-session.target
After=cosmic-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=COSMIC

[Service]
ExecStart=%h/.local/bin/pneuma-clipboard-watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=cosmic-session.target
