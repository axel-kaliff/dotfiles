[Unit]
Description=Mirror Documents/Music/Pictures to the homeserver
Wants=network-online.target
After=network-online.target
OnFailure=workstation-backup-notify.service

[Service]
Type=oneshot
# --delete alone makes this a mirror, not a backup: a local deletion or an
# encrypting-ransomware run propagates within 24h with nothing to restore from.
# --backup-dir keeps every file this run would have deleted or overwritten,
# filed under the run's date on the server, so the mirror gains history.
# The dated path needs a shell for date(1); %% is a literal % to systemd.
# NOTE: workstation-history/ grows without bound — prune it on the server
# (e.g. keep 90 days) once you decide on a retention policy.
ExecStart=/bin/sh -c 'exec /usr/bin/rsync -a --delete --stats \
  --backup --backup-dir="/var/bulk/workstation-history/$(date +%%Y-%%m-%%d)" \
  "$HOME/Documents" "$HOME/Music" "$HOME/Pictures" \
  core@192.168.0.14:/var/bulk/workstation/'
TimeoutStartSec=12h
