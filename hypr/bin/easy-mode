#!/bin/bash
# Easy mode: a floating, mouse-driven desktop for someone who expects macOS.
#
#   easy-mode [on|off|toggle|status]
#
# The compositor half is hypr/toggles/easy-mode.lua. Omarchy sources every .lua
# file in ~/.local/state/omarchy/toggles/hypr/ after the rest of the config, so
# this script only has to copy that file in, or take it out, and reload.
# Omarchy's dock appears by itself on floating workspaces.

set -euo pipefail

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
flag="$state_home/omarchy/toggles/hypr/easy-mode.lua"
source_file="$config_home/hypr/toggles/easy-mode.lua"
saved_buttons="$state_home/pneuma/easy-mode-buttons"
layout_default="$state_home/omarchy/workspace-layouts/default.lua"
saved_layout="$state_home/pneuma/easy-mode-layout-default.lua"

# The shell half. omarchy/shell-easy.json holds a `bar` subtree to swap in and a
# `removePlugins` list to drop -- the eye-break overlays are not something to
# inflict on a guest. The shell has one config file and no override layer, so
# this is applied in place, keeping a byte-for-byte copy of the whole file to put
# back; a re-serialised restore would leave the stowed shell.json reformatted.
shell_json="$config_home/omarchy/shell.json"
easy_shell="$config_home/omarchy/shell-easy.json"
saved_shell="$state_home/pneuma/easy-mode-shell.json"
saved_target="$state_home/pneuma/easy-mode-shell-target"

# That path is a symlink into the dotfiles repo, which a 15-minute timer
# auto-commits and pushes to every machine (scripts/dotfiles-sync.sh). Left
# alone, the rewrite above ships a guest-mode bar as everyone's permanent
# config, and the copy that undoes it lives in ~/.local/state, which does not
# travel -- so no other machine can put it back. Marking the file skip-worktree
# for the duration keeps `git add -A` off it; HEAD stays the real config.
# The shell's atomic writes replace the stow link with a plain file, so keep
# using its original target to find the repo when easy mode ends.
if [[ -f $saved_target ]]; then
  target=$(<"$saved_target")
else
  target=$(realpath "$shell_json")
fi

track_shell() {
  local shell_repo
  shell_repo=$(git -C "$(dirname "$target")" rev-parse --show-toplevel 2>/dev/null || true)
  [[ -n $shell_repo ]] || return 0
  git -C "$shell_repo" update-index "$1" -- "$(realpath --relative-to="$shell_repo" "$target")"
}

# macOS keeps the window buttons on the left. Minimize is deliberately absent:
# Hyprland ignores xdg_toplevel.set_minimized, so that button would be a dead
# control. SUPER + M minimizes, and the dock brings the window back.
easy_buttons='close,maximize:'
button_key=(org.gnome.desktop.wm.preferences button-layout)

is_on() { [[ -f $flag ]]; }

apply_easy_shell() {
  [[ -f $easy_shell ]] || return 0
  python3 - "$shell_json" "$easy_shell" <<'PY'
import json, sys

shell_path, overlay_path = sys.argv[1], sys.argv[2]
with open(shell_path) as handle:
    config = json.load(handle)
with open(overlay_path) as handle:
    overlay = json.load(handle)

config["bar"] = overlay["bar"]

dropped = set(overlay.get("removePlugins", []))
if dropped:
    config["plugins"] = [p for p in config.get("plugins", []) if p.get("id") not in dropped]

with open(shell_path, "w") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
PY
}

enable() {
  if [[ ! -f $source_file ]]; then
    echo "easy-mode: $source_file is missing (is the dotfiles hypr package stowed?)" >&2
    exit 1
  fi

  mkdir -p "${flag%/*}" "${saved_buttons%/*}"
  # Record what is being replaced, so `off` restores what was actually there
  # rather than a guess. Only on the way in: a second `on` must not overwrite
  # the saved originals with easy mode's own.
  if ! is_on; then
    gsettings get "${button_key[@]}" >"$saved_buttons"
    cp "$shell_json" "$saved_shell"
    realpath "$shell_json" >"$saved_target"
    if [[ -f $layout_default ]]; then
      cp "$layout_default" "$saved_layout"
    fi
  fi
  mkdir -p "${layout_default%/*}"
  printf '%s\n' 'o.workspace_mode({ default = "floating" })' >"$layout_default"
  cp "$source_file" "$flag"
  gsettings set "${button_key[@]}" "$easy_buttons"
  track_shell --skip-worktree
  apply_easy_shell
}

disable() {
  rm -f "$flag"
  if [[ -f $saved_layout ]]; then
    mv "$saved_layout" "$layout_default"
  else
    rm -f "$layout_default"
  fi
  if [[ -s $saved_buttons ]]; then
    gsettings set "${button_key[@]}" "$(<"$saved_buttons")"
    rm -f "$saved_buttons"
  else
    gsettings reset "${button_key[@]}"
  fi
  # Restoring the whole file, not just the bar subtree: this is the copy taken
  # before easy mode touched it, so the stowed shell.json comes back byte for
  # byte. Bar edits made *during* easy mode are discarded with it.
  # Atomic shell saves can detach the stow link: restore the repo file and
  # reconnect it, so later edits still reach the file the sync timer tracks.
  if [[ -s $saved_shell ]]; then
    cp "$saved_shell" "$target"
    if [[ ! -L $shell_json || $(realpath "$shell_json") != "$target" ]]; then
      ln -sfn --relative "$target" "$shell_json"
    fi
  fi
  track_shell --no-skip-worktree
  rm -f "$saved_shell" "$saved_target"
}

case "${1:-toggle}" in
  status)
    is_on && echo on || echo off
    exit 0
    ;;
  on) enable ;;
  off) disable ;;
  toggle)
    if is_on; then disable; else enable; fi
    ;;
  *)
    echo "Usage: easy-mode [on|off|toggle|status]" >&2
    exit 1
    ;;
esac

hyprctl reload >/dev/null
omarchy-shell -q omarchy.dock refresh >/dev/null

if is_on; then
  notify-send -u low "Easy mode on" "Windows float, the dock is out, and clicking focuses."
else
  notify-send -u low "Easy mode off" "Back to tiling."
fi
