#!/bin/bash

# Persistent-session yazi: the tab-session plugin restores the saved tabs and
# then autosaves them on every navigation, so any exit path preserves them.
# Retry the emit until yazi's DDS socket is up (a cold terminal start can take
# a while); ya emit exits non-zero while nothing is listening.

id=$RANDOM
for _ in $(seq 1 25); do
  sleep 0.2
  YAZI_ID=$id ya emit plugin tab-session 2>/dev/null && break
done &

exec yazi --client-id "$id"
