[Desktop Entry]
Name=Workspaces
Comment=Workspace pills with the apps on each; click switches
Type=Application
Icon=com.system76.CosmicAppletWorkspaces
Exec=pneuma-applet-workspaces
Terminal=false
StartupNotify=true
Categories=COSMIC;
Keywords=COSMIC;Applet;Workspace;
NoDisplay=true
X-CosmicApplet=true
X-HostWaylandDisplay=true
X-OverflowPriority=5
X-OverflowMinSize=8
