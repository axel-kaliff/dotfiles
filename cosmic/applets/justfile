# Applets build in the Fedora 44 distrobox (same glibc as the Bluefin guest) with rustup's
# toolchain from the shared home; the target dir stays out of the repo.
box := "f44-cosmic"
export CARGO_TARGET_DIR := env("CARGO_TARGET_DIR", env("HOME") + "/.cache/pneuma-applets-target")

build *ARGS:
  distrobox enter {{box}} -- "$HOME/.cargo/bin/cargo" build --release --workspace {{ARGS}}

check:
  distrobox enter {{box}} -- "$HOME/.cargo/bin/cargo" clippy --release --workspace -- -W clippy::pedantic

# Collect binaries and desktop files into dist/, which `vm sync` ships into the guest.
stage:
  #!/usr/bin/env bash
  set -euo pipefail
  rm -rf dist; mkdir -p dist/bin dist/applications
  for crate in */; do
    crate=${crate%/}; [ -f "$crate/Cargo.toml" ] || continue
    # Every [package] or [[bin]] name that built to a binary (a lib-only package name has none).
    for name in $(sed -n 's/^name = "\(.*\)"/\1/p' "$crate/Cargo.toml"); do
      [ -f "$CARGO_TARGET_DIR/release/$name" ] && install -Dm755 "$CARGO_TARGET_DIR/release/$name" "dist/bin/$name"
    done
    for d in "$crate"/resources/*.desktop; do [ -e "$d" ] && install -Dm644 "$d" -t dist/applications/; done
  done
  ls -R dist
