#!/usr/bin/env bash
# pneuma-cosmic-set <AppId>/v1/<key> <value-or-@file>   write one cosmic-config key atomically
set -euo pipefail
key=${1:?key, e.g. com.system76.CosmicComp/v1/autotile}
value=${2:?value or @path-to-file}
target="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/$key"
mkdir -p "$(dirname "$target")"
tmp=$(mktemp -p "$(dirname "$target")" ".${key##*/}.XXXXXX")
if [[ $value == @* ]]; then cat "${value#@}" >"$tmp"; else printf '%s\n' "$value" >"$tmp"; fi
mv -f "$tmp" "$target"
