#!/usr/bin/env bash
# Region screenshot through the COSMIC portal, then a notification whose action opens Gradia.
set -euo pipefail
HERE=$(dirname "$(readlink -f "$0")")
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
file=$(cosmic-screenshot --interactive=true --modal=true --notify=false --save-dir "$dir" | tail -n1 || true)
file=${file#file://}
[[ -f $file ]] || file=$(find "$dir" -maxdepth 1 -name '*.png' -newermt '-10 seconds' -printf '%p\n' | head -1)
[[ -f $file ]] || exit 0
action=$(notify-send -a pneuma -i "$file" -A edit=Edit 'Screenshot saved' "$(basename "$file")" 2>/dev/null || true)
[[ $action == edit ]] && exec "$HERE/gradia-edit" "$file"
exit 0
