#!/usr/bin/env bash
# pneuma-cheatsheet zellij|cosmic   searchable key reference in a floating terminal.
set -euo pipefail
HERE=$(dirname "$(readlink -f "$0")")
which=${1:-cosmic}
if [[ ${2:-} != --inner ]]; then exec "$HERE/pneuma-term" org.pneuma.cheatsheet "$0" "$which" --inner; fi
case "$which" in
  zellij)
    awk '/^## / { printf "\n── %s ──\n", toupper(substr($0, 4)); next }
         /^\|/ { line=$0; sub(/^\|[[:space:]]*/, "", line); sub(/[[:space:]]*\|[[:space:]]*$/, "", line)
                 n=split(line, c, /[[:space:]]*\|[[:space:]]*/); if (n<2 || c[1]=="" || c[1] ~ /^-+$/) next
                 gsub(/`/, "", c[1]); gsub(/`/, "", c[2]); printf "%-30s → %s\n", c[1], c[2] }' \
      "${ZELLIJ_CHEATSHEET:-$HOME/.config/zellij/CHEATSHEET.md}" ;;
  cosmic)
    for f in /usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1/defaults \
             "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom"; do
      [[ -f $f ]] && grep -E '^\s*\(modifiers' "$f"
    done | sed -E 's/^\s*\(modifiers: \[([^]]*)\](, key: "([^"]*)")?\): /\1+\3\t/; s/, /+/g; s/^\+//' | column -t -s $'\t' ;;
  *) echo "usage: pneuma-cheatsheet zellij|cosmic" >&2; exit 2 ;;
esac | { if command -v fzf >/dev/null; then fzf --no-sort --layout=reverse --prompt="$which keys > "; else less; fi; } >/dev/null || true
