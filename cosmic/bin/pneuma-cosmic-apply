#!/usr/bin/env bash
# Apply the COSMIC side of the dotfiles. Config is COPIED into ~/.config/cosmic (cosmic-config
# rewrites keys atomically and a stowed symlink would route every runtime write into the repo,
# where the 15-minute sync timer would commit it); everything else in the repo is stowed as usual.
set -euo pipefail

REPO=${DOTFILES:-$HOME/dotfiles}
D=$REPO/cosmic

mkdir -p "$HOME/.config/cosmic" "$HOME/.local/bin" "$HOME/.local/share/pop-launcher/scripts" \
  "$HOME/.config/environment.d" "$HOME/.local/state/pneuma"

rsync -a "$D/config/" "$HOME/.config/cosmic/"

# The panel layout follows the easy-mode flag, so a re-apply never flips the mode.
if [ -f "$HOME/.local/state/pneuma/easy-mode" ]; then
  for k in plugins_wings plugins_center opacity; do cp -f "$D/panel-layouts/easy/$k" "$HOME/.config/cosmic/com.system76.CosmicPanel.Panel/v1/$k"; done
  printf '["Panel","Dock"]\n' > "$HOME/.config/cosmic/com.system76.CosmicPanel/v1/entries"
fi
# Same for stay-awake: the shipped idle timeout must not undo it.
if [ -f "$HOME/.local/state/pneuma/stay-awake.screen_off_time" ]; then
  "$D/bin/pneuma-cosmic-set" com.system76.CosmicIdle/v1/screen_off_time None
fi

for f in "$D"/bin/*; do ln -sfn "$f" "$HOME/.local/bin/$(basename "$f")"; done
for f in "$D"/pop-launcher/scripts/*; do [ -e "$f" ] && ln -sfn "$f" "$HOME/.local/share/pop-launcher/scripts/$(basename "$f")"; done
for f in "$D"/environment.d/*; do [ -e "$f" ] && cp -f "$f" "$HOME/.config/environment.d/"; done

# The first-run wizard (accessibility, scaling, layout) would re-appear on every fresh VM overlay.
mkdir -p "$HOME/.config/autostart"
printf '[Desktop Entry]\nType=Application\nName=COSMIC Initial Setup\nHidden=true\n' \
  > "$HOME/.config/autostart/com.system76.CosmicInitialSetup.desktop"

if command -v stow >/dev/null; then
  "$REPO/scripts/stow-resolve-conflicts.sh" -d "$HOME" -t "$HOME/.config" dotfiles
  stow -d "$HOME" -t "$HOME/.config" --restow dotfiles
  "$REPO/scripts/stow-resolve-conflicts.sh" -d "$REPO" -t "$HOME" bash
  stow -d "$REPO" -t "$HOME" --restow bash
fi

# Daemons that belong to the COSMIC session (units are stowed from systemd/user).
if [ "${XDG_CURRENT_DESKTOP:-}" = COSMIC ] && [ -x "$HOME/.local/bin/pneuma-safeeyes" ]; then
  systemctl --user daemon-reload
  for unit in pneuma-safeeyes pneuma-clipboard-picker pneuma-clipboard-watch; do
    systemctl --user enable --now "$unit.service" >/dev/null 2>&1 || true
    systemctl --user restart "$unit.service" >/dev/null 2>&1 || true
  done
fi

echo "cosmic config applied from $D"
