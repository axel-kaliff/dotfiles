#!/usr/bin/env bash
# pneuma-term <app-id> <command...>   open a terminal window with that app id running the command.
# Ghostty when present (brew/source build), cosmic-term otherwise.
set -euo pipefail
id=${1:?app-id}; shift
# A separate instance: through the single instance the window would keep the first one's class.
if command -v ghostty >/dev/null; then exec ghostty --gtk-single-instance=false --class="$id" -e "$@"; fi
exec cosmic-term -- "$@"
