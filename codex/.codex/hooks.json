{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/personal-hooks/hook_adapter.py\" before",
            "timeout": 120
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/personal-hooks/hook_adapter.py\" after",
            "timeout": 120
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/personal-hooks/hook_adapter.py\" start",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/personal-hooks/hook_adapter.py\" working",
            "timeout": 120
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/personal-hooks/hook_adapter.py\" waiting",
            "timeout": 120
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/personal-hooks/hook_adapter.py\" done",
            "timeout": 120
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/personal-hooks/hook_adapter.py\" waiting",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
