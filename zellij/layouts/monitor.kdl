layout {
    // default_tab_template only wraps `tab` nodes and runtime tabs — panes at
    // the layout root render bar-less, so the panes must live in a tab.
    tab name="monitor" {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="main"
                pane name="secondary"
            }
            pane split_direction="vertical" {
                pane name="logs"
                pane name="monitoring"
            }
        }
    }
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
}
