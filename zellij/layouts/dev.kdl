layout {
    // default_tab_template only wraps `tab` nodes and runtime tabs — panes at
    // the layout root render bar-less, so the panes must live in a tab.
    tab name="dev" {
        pane split_direction="vertical" {
            pane size="70%" borderless=true {
                command "nvim"
            }
            pane split_direction="horizontal" {
                pane size="70%" name="terminal"
                pane size="30%" {
                    command "lazygit"
                }
            }
        }
    }
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
}
