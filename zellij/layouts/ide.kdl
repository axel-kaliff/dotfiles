layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    // default_tab_template only wraps `tab` nodes and runtime tabs — panes at
    // the layout root render bar-less, so the IDE panes must live in a tab.
    tab name="ide" {
        pane split_direction="vertical" {
            // Claude gets the wide side — its TUI reflows badly when narrow.
            // Frame stays on (not borderless): the claude-status hook renders
            // the agent state icon in the pane title.
            pane size="58%" name="claude" focus=true {
                command "claude"
            }
            pane size="42%" split_direction="horizontal" {
                pane size="70%" name="git" {
                    command "nvim"
                    args "-c" "Neogit kind=replace" "-c" "lua require('custom.neogit_watch').start()"
                }
                pane size="30%" name="shell"
            }
        }
    }
}
