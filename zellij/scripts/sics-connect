#!/bin/bash

# Ghostty's ssh-terminfo integration only wraps ssh in interactive shells, so
# install the terminfo ourselves here. Unconditional on purpose: the old
# "already installed" marker never expired and went stale the first time r2d2
# lost the entry.
if [ "$TERM" = xterm-ghostty ] && ! infocmp -x xterm-ghostty | ssh r2d2 tic -x - 2>/dev/null; then
    export TERM=xterm-256color
fi

# Lock local zellij so keybinds pass through to remote
if [ -n "$ZELLIJ" ]; then
    zellij action switch-mode locked
fi

ssh r2d2 -t '$HOME/.linuxbrew/bin/zellij attach -c main'

# Unlock local zellij after disconnect
if [ -n "$ZELLIJ" ]; then
    zellij action switch-mode normal
fi
