#!/usr/bin/env bash
# Wrapper for zellij `scrollback_editor` — opens nvim at the last line and
# silences the DSR-warning hit-enter prompt that triggers inside zellij panes.
#
# nvim is resolved at runtime rather than hardcoded: these dotfiles auto-sync
# across machines whose Homebrew/Linuxbrew prefixes differ (e.g. r2d2 uses
# ~/.linuxbrew, others use /home/linuxbrew/.linuxbrew). A hardcoded path silently
# fails with exit 127 and leaves the scrollback pane stuck.
set -euo pipefail

find_nvim() {
  local candidate
  if candidate=$(command -v nvim 2>/dev/null); then
    printf '%s\n' "$candidate"
    return 0
  fi
  for candidate in \
    "$HOME/.linuxbrew/bin/nvim" \
    /home/linuxbrew/.linuxbrew/bin/nvim \
    /opt/homebrew/bin/nvim \
    /usr/local/bin/nvim \
    /usr/bin/nvim; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

if ! nvim_bin=$(find_nvim); then
  echo "scrollback-editor: could not find an nvim binary in PATH or known prefixes" >&2
  exit 127
fi

exec "$nvim_bin" \
  --cmd 'lua vim.notify = function() end' \
  +'$' \
  "$@"
