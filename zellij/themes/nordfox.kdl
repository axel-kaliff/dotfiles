themes {
    nordfox {
        // Nordfox palette — sourced from EdenEast/nightfox.nvim (lua/nightfox/palette/nordfox.lua)
        // bg1 #2e3440 (46,52,64) — default background
        // fg1 #cdcecf (205,206,207) — default foreground
        // blue #81a1c1 (129,161,193) — primary accent
        // cyan #88c0d0 (136,192,208) — secondary
        // green #a3be8c (163,190,140) — tertiary / success
        // magenta #b48ead (180,142,173) — quaternary
        // yellow #ebcb8b (235,203,139) — warning
        // red #bf616a (191,97,106) — error
        // sel0 #3e4a5b (62,74,91) — visual selection bg
        // bg2 #39404f (57,64,79) — inactive ribbon bg
        // bg3 #444c5e (68,76,94) — frame
        // white #e5e9f0 (229,233,240) — bright text
        text_unselected {
            base 205 206 207
            background 46 52 64
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        text_selected {
            base 205 206 207
            background 62 74 91
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        ribbon_unselected {
            base 205 206 207
            background 57 64 79
            emphasis_0 163 190 140
            emphasis_1 180 142 173
            emphasis_2 136 192 208
            emphasis_3 235 203 139
        }
        ribbon_selected {
            base 46 52 64
            background 129 161 193
            emphasis_0 229 233 240
            emphasis_1 229 233 240
            emphasis_2 229 233 240
            emphasis_3 229 233 240
        }
        table_title {
            base 205 206 207
            background 46 52 64
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        table_cell_unselected {
            base 205 206 207
            background 46 52 64
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        table_cell_selected {
            base 205 206 207
            background 62 74 91
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        list_unselected {
            base 205 206 207
            background 46 52 64
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        list_selected {
            base 205 206 207
            background 62 74 91
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        frame_selected {
            // neon pink (#ff10f0) override — not in the nordfox palette; makes
            // the focused pane frame unmistakable
            base 255 16 240
            background 46 52 64
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        frame_highlight {
            base 129 161 193
            background 46 52 64
            emphasis_0 129 161 193
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        exit_code_success {
            base 163 190 140
            background 46 52 64
            emphasis_0 163 190 140
            emphasis_1 163 190 140
            emphasis_2 163 190 140
            emphasis_3 163 190 140
        }
        exit_code_error {
            base 191 97 106
            background 46 52 64
            emphasis_0 191 97 106
            emphasis_1 191 97 106
            emphasis_2 191 97 106
            emphasis_3 191 97 106
        }
        multiplayer_user_colors {
            player_1 129 161 193
            player_2 136 192 208
            player_3 163 190 140
            player_4 235 203 139
            player_5 191 97 106
            player_6 205 206 207
            player_7 180 142 173
            player_8 90 101 125
            player_9 68 76 94
            player_10 62 74 91
        }
    }
}
