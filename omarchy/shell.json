{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "pneuma.menu"
        },
        {
          "id": "akaliff.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "pneuma.safeeyes"
        },
        {
          "id": "omarchy.clock",
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "pneuma.clipboard"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "pneuma.pomodoro"
        },
        {
          "id": "akaliff.agents",
          "providers": {
            "codex": {
              "enabled": false
            }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "akaliff.media"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "id": "akaliff.bar"
  },
  "plugins": [
    {
      "id": "akaliff.notifications"
    },
    {
      "id": "pneuma.safeeyes"
    },
    {
      "id": "akaliff.osd"
    },
    {
      "id": "pneuma.switcher"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.media",
    "omarchy.osd"
  ],
  "cloneSourceRestores": [
    "akaliff.notifications",
    "akaliff.media",
    "akaliff.osd"
  ]
}
