{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "pneuma.menu"
        },
        {
          "id": "pneuma.app-name"
        },
        {
          "id": "akaliff.workspaces"
        }
      ],
      "center": [],
      "right": [
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM  HH:mm"
        },
        {
          "id": "pneuma.controls"
        },
        {
          "id": "pneuma.clipboard"
        },
        {
          "id": "pneuma.tray",
          "alwaysExpanded": true
        },
        {
          "id": "pneuma.pomodoro"
        },
        {
          "id": "akaliff.media"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "pneuma.keyboard-layout",
          "flags": {
            "EN": "🇬🇧",
            "SV": "🇸🇪"
          }
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "pneuma.easy-mode"
        }
      ]
    },
    "id": "akaliff.bar"
  },
  "plugins": [
    {
      "id": "akaliff.icons"
    },
    {
      "id": "akaliff.notifications"
    },
    {
      "id": "akaliff.osd"
    },
    {
      "id": "pneuma.switcher"
    },
    {
      "id": "pneuma.dock"
    },
    {
      "id": "pneuma.window-menu"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.media",
    "omarchy.osd"
  ],
  "cloneSourceRestores": [
    "akaliff.notifications",
    "akaliff.media",
    "akaliff.osd"
  ]
}
