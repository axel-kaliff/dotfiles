{
  "bar": {
    "background": "opaque",
    "centerAnchor": "akaliff.clock",
    "id": "akaliff.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "StayAwake"
          ]
        },
        {
          "id": "pneuma.safeeyes"
        },
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "akaliff.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "flags": {
            "EN": "🇬🇧",
            "SV": "🇸🇪"
          },
          "id": "pneuma.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "left": [
        {
          "id": "pneuma.menu"
        },
        {
          "id": "akaliff.workspaces"
        }
      ],
      "right": [
        {
          "id": "pneuma.clipboard"
        },
        {
          "id": "akaliff.tray"
        },
        {
          "id": "pneuma.pomodoro",
          "workMinutes": 10
        },
        {
          "id": "akaliff.agents",
          "providers": {
            "codex": {
              "enabled": false
            }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "akaliff.media"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "pneuma.easy-mode"
        }
      ]
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "akaliff.notifications",
    "akaliff.media",
    "akaliff.osd"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.media",
    "omarchy.osd"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "akaliff.notifications"
    },
    {
      "id": "pneuma.safeeyes"
    },
    {
      "id": "akaliff.osd"
    },
    {
      "id": "pneuma.switcher"
    },
    {
      "id": "pneuma.window-menu"
    },
    {
      "id": "pneuma.overview"
    }
  ],
  "version": 1
}
